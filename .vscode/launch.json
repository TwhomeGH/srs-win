{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SRS Windows (default features, Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/trunk/ide/srs_msvc/build/Debug/srs.exe",
            "args": ["-c", "${workspaceFolder}/dev/windows/dev.conf"],
            "cwd": "${workspaceFolder}/trunk/ide/srs_msvc/build/Debug",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "preLaunchTask": "build-srs-debug"
        },
        {
            "name": "SRS Windows (full RTC/SRT, Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/trunk/ide/srs_msvc/build-full/Debug/srs.exe",
            "args": ["-c", "${workspaceFolder}/dev/windows/dev.conf"],
            "cwd": "${workspaceFolder}/trunk/ide/srs_msvc/build-full/Debug",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "preLaunchTask": "build-srs-full"
        },
        {
            "name": "SRS event loop test",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/trunk/ide/srs_msvc/build/Debug/st-event-loop-test.exe",
            "cwd": "${workspaceFolder}/trunk/ide/srs_msvc/build/Debug",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "preLaunchTask": "build-srs-debug"
        },
        {
            "name": "Attach to srs.exe",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "SRS proxy (Go)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "cwd": "${workspaceFolder}/proxy",
            "program": "${workspaceFolder}/proxy"
        },
        {
            "name": "UI: Vitest (Windows)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm --prefix ui test",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "UI: Vite dev server",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm --prefix ui run dev",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "UI: RTC E2E (full, no auth)",
            "type": "node-terminal",
            "request": "launch",
            "command": "pwsh -NoProfile -File dev/rtc-e2e.ps1",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "UI: Auth E2E (full, auth)",
            "type": "node-terminal",
            "request": "launch",
            "command": "pwsh -NoProfile -File dev/auth-e2e.ps1",
            "cwd": "${workspaceFolder}"
        }
    ]
}
