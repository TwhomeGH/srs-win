{
    "configurations": [
        {
            "name": "Win32 Default",
            "includePath": [
                "${workspaceFolder}/trunk/src/core",
                "${workspaceFolder}/trunk/src/kernel",
                "${workspaceFolder}/trunk/src/protocol",
                "${workspaceFolder}/trunk/src/app",
                "${workspaceFolder}/trunk/src/main",
                "${workspaceFolder}/trunk/ide/srs_msvc",
                "${workspaceFolder}/trunk/ide/srs_msvc/build",
                "${workspaceFolder}/trunk/3rdparty/st-srs",
                "${env:VCPKG_ROOT}/installed/x64-windows/include",
                "H:/vcpkg/installed/x64-windows/include",
                "C:/Program Files/OpenSSL-Win64/include"
            ],
            "defines": ["_WIN32", "_DEBUG", "SRS_AUTO_SSL", "SRS_AUTO_SSL_USE", "SRS_FFMPEG_STUB", "SRS_AUTO_H265"],
            "windowsSdkVersion": "10.0.26100.0",
            "compilerPath": "cl.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "msvc-x64"
        },
        {
            "name": "Win32 Full (RTC/SRT)",
            "includePath": [
                "${workspaceFolder}/trunk/src/core",
                "${workspaceFolder}/trunk/src/kernel",
                "${workspaceFolder}/trunk/src/protocol",
                "${workspaceFolder}/trunk/src/app",
                "${workspaceFolder}/trunk/src/main",
                "${workspaceFolder}/trunk/ide/srs_msvc",
                "${workspaceFolder}/trunk/ide/srs_msvc/build-full",
                "${workspaceFolder}/trunk/3rdparty/st-srs",
                "${env:VCPKG_ROOT}/installed/x64-windows/include",
                "H:/vcpkg/installed/x64-windows/include",
                "C:/Program Files/OpenSSL-Win64/include"
            ],
            "defines": ["_WIN32", "_DEBUG", "SRS_AUTO_SSL", "SRS_AUTO_SSL_USE", "SRS_AUTO_RTC_USE", "SRS_AUTO_SRT_USE", "SRS_FFMPEG_FIT", "SRS_AUTO_H265"],
            "windowsSdkVersion": "10.0.26100.0",
            "compilerPath": "cl.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "msvc-x64"
        }
    ],
    "version": 4
}
