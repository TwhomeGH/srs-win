# Doxygen configuration for the SRS-Win API reference.
# The generated site is written to build/doxygen/html; changelogkit export
# copies it to _site/api-docs/cpp when [tool.changelog.api] has embed = true.
# .github/workflows/pages.yml runs Doxygen before the changelogkit export.
#
# Local preview (no local Doxygen install required):
#   docker run --rm -v "${PWD}:/src" -w /src ubuntu:24.04 \
#     bash -lc "apt-get update -qq && apt-get install -y -qq doxygen >/dev/null && doxygen Doxyfile"
# Windows with MSYS2: add C:\msys64\ucrt64\bin to PATH, then run:
#   doxygen Doxyfile

PROJECT_NAME           = "SRS-Win"
PROJECT_NUMBER         = "7.0.0"
PROJECT_BRIEF          = "Windows native port of Simple Realtime Server"
OUTPUT_DIRECTORY       = build/doxygen
# Doxygen's Chinese UI catalog is stale as of 1.16; keep built-in UI English.
# This only affects Doxygen's own labels, not source comments or Docs/API導讀.md.
OUTPUT_LANGUAGE        = English
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
FULL_PATH_NAMES        = NO

INPUT                  = trunk/src \
                         Docs/API導讀.md
FILE_PATTERNS          = *.hpp *.h *.cpp
RECURSIVE              = YES
EXCLUDE                = trunk/src/utest
EXCLUDE_PATTERNS       = */utest/* */3rdparty/*

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
SEARCH_INCLUDES        = YES
USE_MDFILE_AS_MAINPAGE = Docs/API導讀.md
INCLUDE_PATH           = trunk/src/core trunk/src/kernel trunk/src/protocol trunk/src/app
PREDEFINED             = _WIN32 SRS_AUTO_SSL SRS_AUTO_SSL_USE SRS_AUTO_RTC_USE SRS_AUTO_SRT_USE SRS_AUTO_H265 SRS_AUTO_H265_USE SRS_FFMPEG_FIT SRS_AUTO_GB28181

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES
SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
HAVE_DOT               = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

QUIET                  = YES
WARN_LOGFILE           = doxygen-warnings.log
