{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 19,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-default",
      "displayName": "Windows Debug (system OpenSSL, RTC/SRT off)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "SRS_BUILD_ST_TESTS": "ON"
      }
    },
    {
      "name": "windows-full",
      "displayName": "Windows Debug with vcpkg (RTC/SRT on)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-full",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "SRS_BUILD_ST_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-default-debug",
      "configurePreset": "windows-default",
      "configuration": "Debug"
    },
    {
      "name": "windows-full-debug",
      "configurePreset": "windows-full",
      "configuration": "Debug"
    },
    {
      "name": "windows-full-release",
      "configurePreset": "windows-full",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-default-test",
      "configurePreset": "windows-default",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-full-test",
      "configurePreset": "windows-full",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
